### Flowseal zapret-discord-youtube "ALT3"
--filter-udp=443
--hostlist=/usr/share/zapret/lists/list-general.txt
--hostlist=/etc/storage/zapret/user.list
--hostlist-exclude=/usr/share/zapret/lists/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list
--dpi-desync=fake
--dpi-desync-repeats=6
--dpi-desync-fake-quic=/usr/share/zapret/fake/flowseal/quic_initial_www_google_com.bin
--new
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--dpi-desync=fake
--dpi-desync-fake-discord=/usr/share/zapret/fake/flowseal/ACTIVE_DISCORD_UDP.bin
--dpi-desync-fake-stun=/usr/share/zapret/fake/flowseal/ACTIVE_DISCORD_UDP.bin
--dpi-desync-repeats=6
--new
--filter-tcp=2053,2083,2087,2096,8443
--hostlist-domains=discord.media
--dpi-desync=fake,hostfakesplit
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
--dpi-desync-hostfakesplit-mod=host=www.google.com,altorder=1
--dpi-desync-fooling=ts
--new
--filter-tcp=443
--hostlist=/usr/share/zapret/lists/list-google.txt
--ip-id=zero
--dpi-desync=fake,hostfakesplit
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
